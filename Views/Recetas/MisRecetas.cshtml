@foreach (var item in Model)
{
    <div class="col-md-6 col-lg-4 mb-4">
        <div class="card shadow-sm border-0 rounded-3 h-100 style-card" style="background-color: #FFF9F2;">
            <div class="card-body d-flex flex-column justify-content-between">

                <!-- Encabezado de la Tarjeta: Visibilidad y Precio -->
                <div>
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        @if (item.EsPublica)
                        {
                            <span class="badge bg-success">🌐 Pública</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">🔒 Privada</span>
                        }
                        <h5 class="fw-bold text-dark mb-0">C$ @item.CostoTotalProduccion.ToString("N2")</h5>
                    </div>

                    <!-- Nombre de la Receta (Clic en el título para abrir detalle) -->
                    <a asp-action="Detalle" asp-route-id="@item.Id" class="text-decoration-none">
                        <h4 class="fw-bold text-capitalize mb-3" style="color: #6B2638;">@item.Nombre</h4>
                    </a>

                    <!-- Detalles rápidos de Molde, Peso e Ingredientes -->
                    <p class="text-muted mb-1 fs-7">
                        <strong>Molde:</strong> @(string.IsNullOrEmpty(item.Molde) ? "No especificado" : item.Molde)
                    </p>
                    <p class="text-muted mb-1 fs-7">
                        <strong>Peso Final:</strong> @item.PesoFinal.ToString("N2") g
                    </p>
                    <p class="text-muted mb-3 fs-7">
                        <strong>Ingredientes:</strong> @(item.Detalles?.Count ?? 0) registrados
                    </p>
                </div>

                <!-- Botones de Acción: Ver 👁️, Editar ✏️ y Eliminar 🗑️ -->
                <div class="d-flex justify-content-between gap-1 mt-3">
                    <a asp-action="Detalle" asp-route-id="@item.Id" class="btn btn-info text-white flex-fill btn-sm fw-bold">
                        Ver 👁️
                    </a>
                    <a asp-action="Editar" asp-route-id="@item.Id" class="btn text-white flex-fill btn-sm fw-bold" style="background-color: #6B2638;">
                        Editar ✏️
                    </a>
                    <a asp-action="Eliminar" asp-route-id="@item.Id" class="btn btn-danger flex-fill btn-sm fw-bold">
                        Eliminar 🗑️
                    </a>
                </div>

            </div>
        </div>
    </div>
}