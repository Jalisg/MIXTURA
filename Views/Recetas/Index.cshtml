@model IEnumerable<MIXTURAA.Models.Receta>

@{
    ViewData["Title"] = "Mis Recetas Guardadas";
}

<h2 class="fw-bold mb-4">MIS RECETAS GUARDADAS</h2>

<div class="row g-3">
    @if (!Model.Any())
    {
        <div class="col-12">
            <div class="card-creme text-center py-5">
                <p class="mb-0 text-muted fs-5">Aún no has guardado recetas en la base de datos.</p>
                <a asp-action="Crear" class="btn btn-burgundy mt-3">Crear Nueva Receta Base</a>
            </div>
        </div>
    }
    else
    {
        @foreach (var receta in Model)
        {
            <div class="col-md-6">
                <div class="card-creme">
                    <h4 class="fw-bold text-danger">@receta.Nombre</h4>
                    <p class="mb-1"><b>Molde:</b> @receta.Molde</p>
                    <p class="mb-1"><b>Peso Final:</b> @receta.PesoFinal g</p>
                    <hr />
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="fs-5">Costo Producción:</span>
                        <span class="fw-bold fs-4">$@receta.CostoTotalProduccion</span>
                    </div>
                </div>
            </div>
        }
    }
</div>