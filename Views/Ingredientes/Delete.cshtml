@model MIXTURAA.Models.Ingrediente

@{
    ViewData["Title"] = "Eliminar Insumo";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm p-4 bg-white" style="border-radius: 12px;">
                <h3 class="fw-bold text-danger mb-3">🗑️ ¿ELIMINAR INSUMO?</h3>
                <p class="text-muted">¿Estás seguro de que deseas eliminar este insumo del catálogo?</p>

                <div class="p-3 mb-4 rounded" style="background-color: #FFF9F2;">
                    <div><strong>Nombre:</strong> @Model.Nombre</div>
                    <div><strong>Presentación:</strong> @Model.CantidadPresentacion @Model.UnidadMedida</div>
                    <div><strong>Precio Compra:</strong> C$ @Model.PrecioCompra.ToString("N2")</div>
                </div>

                <form asp-action="Delete">
                    <input type="hidden" asp-for="Id" />
                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                        <button type="submit" class="btn btn-danger fw-bold">Sí, Eliminar Insumo</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>